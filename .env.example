# Copy this file to .env and edit as needed. Every value shown is the
# default -- the project runs fully offline with zero keys out of the box.

# --- Embeddings -----------------------------------------------------------
# tfidf (default, offline, no downloads) | huggingface | openai
EMBEDDING_PROVIDER=tfidf
HUGGINGFACE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- LLM --------------------------------------------------------------------
# mock (default, offline, free) | gemini (free tier) | anthropic | openai
LLM_PROVIDER=mock
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-3.1-flash-lite
LLM_TEMPERATURE=0.1

# Required only if LLM_PROVIDER=gemini -- get a free key (no credit card):
# https://aistudio.google.com/apikey
# GEMINI_API_KEY=AIza...

# Required only if LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# Required only if LLM_PROVIDER=openai or EMBEDDING_PROVIDER=openai
# OPENAI_API_KEY=sk-...

# --- Retrieval / graph behavior --------------------------------------------
TOP_K_PER_SOURCE=4
MAX_GRAPH_ITERATIONS=2
CONFIDENCE_THRESHOLD=0.55

# --- Chunking ---------------------------------------------------------------
CODE_CHUNK_MAX_LINES=80
CODE_CHUNK_OVERLAP_LINES=10
TEXT_CHUNK_MAX_CHARS=1800
TEXT_CHUNK_OVERLAP_CHARS=200

# --- Optional: raises GitHub API rate limit for scripts/fetch_incidents.py -
# GITHUB_TOKEN=ghp_...
